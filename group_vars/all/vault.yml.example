---
# MODELO. O arquivo real é group_vars/all/vault.yml, que está no .gitignore.
#
# PRIMEIRA VEZ (o vault ainda não existe):
#   cp group_vars/all/vault.yml.example group_vars/all/vault.yml
#   nano group_vars/all/vault.yml          # preencher os valores
#   ansible-vault encrypt group_vars/all/vault.yml
#
# DEPOIS (o vault já existe e está cifrado) — NÃO rodar 'encrypt' de novo:
#   ansible-vault edit group_vars/all/vault.yml     # decifra, abre, recifra
#   ansible-vault view group_vars/all/vault.yml     # só consultar
#
# A senha do vault vem de ANSIBLE_VAULT_PASSWORD_FILE (ver ansible.cfg).
# Sem ela definida, acrescente --ask-vault-pass aos comandos.
#
# Conferir se o vault tem tudo o que o código pede:
#   diff <(ansible-vault view group_vars/all/vault.yml \
#            | grep -oE '^vault_[a-z_]+' | sort) \
#        <(grep -rhoE 'vault_[a-z_]+' roles/ *.yml *.yaml group_vars/windows.yml \
#            | sort -u)

# Conta de serviço do SQL Server (roles/maintenance/tasks/sqlserver.yaml)
vault_senha_sqlserver: "TROCAR"

# --- Login 'sa' do SQL Server 2014 --------------------------------------------
# São DUAS senhas para o mesmo login, e isso é proposital.
#
# Na instalação, o SQL Server aplica a política de senha do Windows: mínimo de
# 8 caracteres e ao menos 3 das 4 categorias (maiúscula, minúscula, dígito,
# símbolo). Uma senha simples é recusada e a instalação falha.
# Usada em roles/sql_server_2014/tasks/main.yaml.
# Exigência do instalador: 8+ caracteres, com maiúscula, minúscula, dígito
# e símbolo. Uma senha simples é recusada e a instalação falha.
vault_senha_sa_instalacao: "TROCAR_COMPLEXA"

# Depois de instalado, o fix_sql_auth.yml roda ALTER LOGIN com CHECK_POLICY=OFF
# e então pode definir a senha simples que os alunos usam em aula.
# Usada em roles/sql_server_2014/tasks/fix_sql_auth.yml.
vault_senha_sa: "TROCAR"

# Superusuário 'postgres' do PostgreSQL (postgres.yml).
# NÃO confundir com as do SQL Server: são bancos diferentes.
vault_senha_postgres: "TROCAR"

# Conta de estudo do Power BI (roles/maintenance/tasks/powerbi.yaml)
vault_senha_powerbi: "TROCAR"

# root do MySQL instalado via Chocolatey (roles/smd/tasks/main.yaml)
vault_senha_mysql_root: "TROCAR"

# Conta 'aluno' das estações (roles/mediaweek/tasks/mw2022-lab4.yaml)
vault_senha_aluno: "TROCAR"

# Conta 'localwp' (localwp.yaml)
vault_senha_localwp: "TROCAR"

# Senha da conta de LEITURA no Samba //10.44.24.130/smd, usada pelo controlador
# para montar o compartilhamento de instaladores (roles/repo_local).
# Usuário e domínio ficam em roles/repo_local/defaults/main.yml.
vault_senha_smb: "TROCAR"

# Senha de aplicativo do Gmail/Google Workspace, usada pelo auditoria.yml para
# enviar o relatório diário de desvio. NÃO é a senha da conta: em contas com
# verificação em duas etapas é preciso gerar uma "senha de app" em
# https://myaccount.google.com/apppasswords
vault_senha_smtp: "TROCAR"

# Conta administrativa 'suporte' das estações Windows — CREDENCIAL DE CONEXÃO.
# ATENÇÃO: use aqui a senha que JÁ está em uso nas máquinas (a mesma que você
# passava com -k). Não invente uma nova: é a credencial compartilhada da equipe
# e nenhuma role a altera.
# Usada em: group_vars/windows.yml
vault_senha_suporte: "SENHA_ATUAL_EM_USO"

# Conta 'Suporte' criada pela role tecnodocencia (obsoleta, sem playbook que a
# chame). Deliberadamente separada de vault_senha_suporte: são contextos
# diferentes e não devem compartilhar segredo.
vault_senha_suporte_tecnodocencia: "TROCAR"

# Usada SOMENTE durante uma rotação de senha, pelo playbook
# rotacionar_senha_suporte.yml. Fora de uma rotação em andamento, deixe
# comentada. Ver o cabeçalho daquele playbook para o procedimento completo.
# vault_senha_suporte_nova: "SENHA_NOVA"

# Conta 'Bolsista' (roles/tecnodocencia/vars/main.yaml).
# Esta É rotacionada a cada execução da role — pode definir uma senha nova.
vault_senha_bolsista: "TROCAR"
